# codex: signed-in local CLI; deepseek: official API; http: custom chat API.
# The extension's AI settings save to data/provider.json and override these defaults.
AGENT_PROVIDER=codex
# Optional. The launch script discovers codex.exe on PATH.
CODEX_EXE=
# Keep blank to use the model configured in Codex.
CODEX_MODEL=
AGENT_TIMEOUT_MS=180000
# For http, include /v1 if required. DeepSeek defaults to https://api.deepseek.com.
AGENT_BASE_URL=
AGENT_API_KEY=
# DeepSeek defaults to deepseek-flash; the model name remains editable.
AGENT_MODEL=
# json_schema, json_object, or text. DeepSeek defaults to json_object.
AGENT_RESPONSE_FORMAT=
AGENT_MAX_TOKENS=8192
# Optional local bank, defaults to data/question-bank.json; see README for schema.
QUESTION_BANK_FILE=
# local | daxuesoutijiang | generic. The popup saves the choice locally.
QUESTION_BANK_PROVIDER=local
# Optional authorized generic adapter endpoint, NOT the private search-app API.
# POST {questions,context} -> {answers:[{id,values,confidence,explanation,matchScore}]}.
QUESTION_BANK_URL=
QUESTION_BANK_API_KEY=
QUESTION_BANK_MIN_MATCH=0.95
QUESTION_BANK_TIMEOUT_MS=10000
PORT=18765
